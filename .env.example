POSTGRES_DB=testimonial_cms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:change-this-local-password@localhost:5432/testimonial_cms?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-please-with-at-least-32-characters
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Fecha UTC del primer despliegue compatible; vacío bloquea HTTP legado.
WEBHOOK_LEGACY_HTTP_STARTED_AT=
# Fecha UTC del primer despliegue de sesión por cookies; el modo implícito expira a los 30 días.
AUTH_LEGACY_STARTED_AT=
# JSON con peppers base64url de 32 bytes o más; inyectar desde gestor de secretos.
API_KEY_PEPPERS_JSON=
API_KEY_PEPPER_CURRENT_VERSION=1
# Fecha UTC del primer despliegue compatible de API keys; tms_ vence a los 30 días.
API_KEY_LEGACY_STARTED_AT=
WEBHOOK_SIGNATURE_LEGACY_STARTED_AT=
# Mapa de versiones a claves AES-256-GCM de 32 bytes en base64url; cargar desde gestor de secretos.
WEBHOOK_SECRET_KEYS_JSON=
WEBHOOK_SECRET_CURRENT_VERSION=1
METRICS_TOKEN=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
