PORT=4000
CORS_ORIGIN=http://localhost:3000
# 0 para acceso directo; 1 detrás de Nginx/ALB cuando la API no es accesible directamente.
# En NODE_ENV=production el valor por defecto es 1; ajustá si cambia la topología.
TRUST_PROXY_HOPS=0
WEBHOOK_LEGACY_HTTP_STARTED_AT=
WEBHOOK_SIGNATURE_LEGACY_STARTED_AT=
WEBHOOK_SECRET_KEYS_JSON=
WEBHOOK_SECRET_CURRENT_VERSION=1
METRICS_TOKEN=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
AUTH_LEGACY_STARTED_AT=
API_KEY_LEGACY_STARTED_AT=
# Cargar desde un gestor de secretos: {"1":"<32 bytes aleatorios en base64url>"}.
API_KEY_PEPPERS_JSON=
API_KEY_PEPPER_CURRENT_VERSION=1

DATABASE_URL=postgresql://postgres:change-this-local-password@localhost:5432/testimonial_cms?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-please-with-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_UPLOAD_URL=https://api.cloudinary.com/v1_1/tu_cloud_name/image/upload
CLOUDINARY_UPLOAD_PRESET=tu_preset_no_firmado
# Logos: carga y eliminación firmadas; configurar externamente, sin commitear valores.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Placeholder sólo para testimonios locales; nunca para logos ni producción.
CLOUDINARY_LOCAL_PLACEHOLDER=false

# YouTube
YOUTUBE_API_KEY=tu_google_api_key_aqui
