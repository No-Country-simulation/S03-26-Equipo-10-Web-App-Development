{
  "name": "testimonial-cms",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @testimonial-cms/api\" \"npm run dev --workspace @testimonial-cms/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,md}": [
      "prettier --write"
    ],
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "husky": "8.0.3",
    "lint-staged": "17.6.0",
    "prettier": "3.5.3",
    "supabase": "2.120.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "picomatch": "4.0.7",
    "path-to-regexp": "8.4.2",
    "lodash": "4.18.1",
    "qs": "6.16.0",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6",
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "5.4.3"
    },
    "@next/eslint-plugin-next": {
      "fast-glob": "file:../../../apps/web/tools/next-lint-glob"
    }
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "@prisma/client@6.5.0": true,
    "@prisma/engines@6.5.0": true,
    "@swc/core@1.15.30": true,
    "esbuild@0.28.2": true,
    "prisma@6.5.0": true,
    "protobufjs@7.6.6": false,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": false
  }
}
