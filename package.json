{
  "name": "testimonial-cms",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @testimonial-cms/api\" \"npm run dev --workspace @testimonial-cms/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,md}": [
      "prettier --write"
    ],
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "husky": "8.0.3",
    "lint-staged": "15.5.2",
    "prettier": "3.5.3"
  },
  "overrides": {
    "picomatch": "4.0.4",
    "path-to-regexp": "8.3.0",
    "lodash": "4.17.21",
    "qs": "6.14.2"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=10.9.9 <11"
  }
}
